<Page
    x:Class="LumiaValley.Pages.TextInputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF0C1C14">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="900">
            <TextBlock Text="Digite o texto:" Foreground="#FFFFEC9E" FontSize="28" Margin="0,0,0,12" />
            <TextBox x:Name="Entry" FontSize="32" MaxLength="24"
                     Background="#FFFFE0B0" Foreground="#FF221122"
                     BorderBrush="#FF9E6A3C" BorderThickness="3"
                     Padding="12,6,12,6">
                <TextBox.InputScope>
                    <InputScope>
                        <InputScope.Names>
                            <InputScopeName NameValue="Text" />
                        </InputScope.Names>
                    </InputScope>
                </TextBox.InputScope>
            </TextBox>
            <Button x:Name="OkButton" Content="OK" FontSize="28"
                    HorizontalAlignment="Right" Width="180" Margin="0,20,0,0"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Page>
