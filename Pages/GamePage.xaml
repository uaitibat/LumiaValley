<Page
    x:Class="LumiaValley.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid>
        <SwapChainPanel x:Name="SwapPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!--
            Caixa de texto invisivel usada apenas para abrir o teclado nativo
            do Windows. Focada via Focus(FocusState.Programmatic), o SIP sobe
            e o texto digitado volta para o jogo pelo evento TextChanged.
        -->
        <TextBox x:Name="NativeInput"
                 Width="1" Height="1"
                 MinWidth="1" MinHeight="1"
                 Opacity="0"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 Margin="0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 IsTabStop="True"
                 TabIndex="0"
                 MaxLength="24" />
    </Grid>
</Page>
