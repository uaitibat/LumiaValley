<Page
    x:Class="LumiaValley.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid>
        <SwapChainPanel x:Name="SwapPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!--
            Campo invisivel usado somente para abrir o teclado nativo do
            Windows. Precisa ter um tamanho normal: com 1x1 o SIP abre
            comprimido e as teclas saem desalinhadas (A vira C, etc).
            IsHitTestVisible=False evita que ele roube toques do jogo;
            o foco e feito programaticamente.
        -->
        <TextBox x:Name="NativeInput"
                 Width="420" Height="48"
                 MinWidth="420" MinHeight="48"
                 Opacity="0"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,72"
                 IsHitTestVisible="False"
                 IsTabStop="True"
                 TabIndex="0"
                 MaxLength="24">
            <TextBox.InputScope>
                <InputScope>
                    <InputScope.Names>
                        <InputScopeName NameValue="Text" />
                    </InputScope.Names>
                </InputScope>
            </TextBox.InputScope>
        </TextBox>
    </Grid>
</Page>
