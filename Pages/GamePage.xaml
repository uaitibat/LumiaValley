<Page
    x:Class="LumiaValley.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid>
        <SwapChainPanel x:Name="SwapPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!--
            Popup usado somente para digitar. Um Popup/foco proprio faz o
            teclado nativo (SIP) abrir de forma confiavel dentro de um app
            MonoGame com SwapChainPanel.
        -->
        <Popup x:Name="InputPopup" IsOpen="False"
               HorizontalOffset="240" VerticalOffset="560">
            <Border x:Name="InputBorder"
                    Width="800" Height="96"
                    Background="#F0102018"
                    BorderBrush="#FF9E6A3C" BorderThickness="3">
                <Grid Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NativeInput" Grid.Column="0"
                             FontSize="28" MaxLength="24"
                             Background="#FFFFE0B0" Foreground="#FF221122"
                             BorderThickness="2" BorderBrush="#FF9E6A3C"
                             Padding="8,4,8,4" VerticalContentAlignment="Center">
                        <TextBox.InputScope>
                            <InputScope>
                                <InputScope.Names>
                                    <InputScopeName NameValue="Text" />
                                </InputScope.Names>
                            </InputScope>
                        </TextBox.InputScope>
                    </TextBox>
                    <Button x:Name="NativeOk" Grid.Column="1" Content="OK"
                            FontSize="24" Margin="12,0,0,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Page>
